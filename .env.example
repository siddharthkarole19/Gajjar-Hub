# Gajjar Hub - Environment Variables
# Copy this file to .env.local and populate with your Supabase project credentials.

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public API Key (safe to use in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Restrict student registrations to a specific college domain (e.g. @svnit.ac.in)
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=
